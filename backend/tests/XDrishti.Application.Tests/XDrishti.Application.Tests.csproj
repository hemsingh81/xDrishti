<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\src\XDrishti.Application\XDrishti.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup>
    <!-- The invented days of P3-03 (F1, F2, flat), shared with the simulation tests: one source file, compiled into each project that needs it (P3-04a). -->
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Real rows of Dhan's scrip master and NSE's sector list (see docs/specs/P1-03), embedded so unit tests never touch the disk. -->
    <EmbeddedResource Include="Fixtures\*.csv" LogicalName="Fixtures/%(Filename)%(Extension)" />
    <!-- Made-up tradebook files for the trade CSV reader (docs/specs/P2-03). -->
    <EmbeddedResource Include="Portfolio\Trades\Samples\*.csv" LogicalName="Trades/%(Filename)%(Extension)" />
    <!-- A made-up dividend payout file in the shape of Dhan's (docs/specs/P2-15): Sept months, thousands separators, repeated and same-day rows. -->
    <EmbeddedResource Include="Portfolio\DividendImport\Samples\*.csv" LogicalName="Dividends/%(Filename)%(Extension)" />
    <!-- A made-up Dhan global transaction report (docs/specs/P2-17): the shape of the real one - title, personal lines, header, bill rows, footer, note - with invented scrips and amounts. -->
    <EmbeddedResource Include="Portfolio\Reports\Samples\*.csv" LogicalName="Reports/%(Filename)%(Extension)" />
  </ItemGroup>
  <Import Project="..\Tests.props" />
</Project>
