<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\src\XDrishti.Infrastructure\XDrishti.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup>
    <!-- The invented days of P3-03 (F1, F2, flat), shared with the simulation tests: one source file, compiled into each project that needs it (P3-04a). -->
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- The constructed packets of docs/research/dhan-samples (hex text, UNVERIFIED), so the parser tests and the documentation cannot drift apart. -->
    <EmbeddedResource Include="..\..\..\docs\research\dhan-samples\feed-*.hex" LogicalName="DhanFeed/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Anonymised, made-up answers shaped like Dhan's trade history and ledger (docs/specs/P2-13), embedded so the mapper and client tests never touch the disk. Replace with real samples after the owner's first real read. -->
    <EmbeddedResource Include="Brokers\Samples\*.json" LogicalName="DhanHistory/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Synthetic depository-charges sheets (docs/specs/P2-17): a legacy BIFF8 .xls and an .xlsx written by Portfolio/Samples/tools/make_dp_samples.py with invented rows - no personal data. -->
    <EmbeddedResource Include="Portfolio\Samples\*.xls;Portfolio\Samples\*.xlsx" LogicalName="Spreadsheets/%(Filename)%(Extension)" />
  </ItemGroup>
  <Import Project="..\Tests.props" />
</Project>
