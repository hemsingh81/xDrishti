<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\src\XDrishti.Simulation\XDrishti.Simulation.csproj" />
    <!-- The independent oracle (ADR 0047, P3-08): the comparison of its walk and gate with the engine's lives in this project. -->
    <ProjectReference Include="..\XDrishti.SimOracle\XDrishti.SimOracle.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The invented days of P3-03 (F1, F2, F6, the flat day), shared with the tests of the use case that reads the stored bars (P3-04a): one source file, compiled into each project that needs it. -->
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <Using Include="XDrishti.Tests.Shared" />
  </ItemGroup>
  <ItemGroup>
    <!-- The golden files (walker, scanner; see GoldenFile): the tests find them next to the binaries. -->
    <Content Include="Golden\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The stored texts of the built-in strategies (ADR 0056, 0079): the tests of the YAML-only strategies read the very files the seed embeds. -->
    <Content Include="..\..\src\XDrishti.Infrastructure\Seed\Strategies\*.yaml" Link="Seed\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The dry-read table and the disagreement log of P3-08 (docs/research): the field-coverage and log tests read them next to the binaries, as the golden files are read. -->
    <Content Include="..\..\..\docs\research\p3-08-*.md" Link="Oracle\Docs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="..\Tests.props" />
</Project>
