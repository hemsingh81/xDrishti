<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\src\XDrishti.Simulation\XDrishti.Simulation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The golden file of the scanner column: what the scanner says on every fixture. Regenerated on purpose when a rule changes (a changed rule needs a new SimulationEngine.Version). -->
    <EmbeddedResource Include="Determinism\scanner.golden.txt" LogicalName="Golden/scanner.golden.txt" />
    <!-- The golden file of the walker fixtures (AC7); the test finds it next to the binaries. -->
    <Content Include="Golden\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="..\Tests.props" />
</Project>
