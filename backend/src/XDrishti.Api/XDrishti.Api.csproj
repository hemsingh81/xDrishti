<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- HTTP host: endpoints, OpenAPI, health. Thin: no business logic here, only mapping to Application handlers. -->
  <PropertyGroup>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- OpenAPI contract written at build time when requested (scripts/gen-api.sh): frontend types are generated from it. -->
    <OpenApiGenerateDocuments Condition="'$(OpenApiGenerateDocuments)' == ''">false</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../contracts</OpenApiDocumentsDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\XDrishti.Infrastructure\XDrishti.Infrastructure.csproj" />
    <ProjectReference Include="..\XDrishti.Hosting\XDrishti.Hosting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="XDrishti.Api.IntegrationTests" />
  </ItemGroup>
</Project>
