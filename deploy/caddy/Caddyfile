# xd-proxy: the only published entry point. Serves the React build and routes API traffic to xd-api.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# The app, the API and the guarded docs are one origin: forbid foreign scripts, frames, forms and plugins.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# API, OpenAPI docs and health → xd-api.
	@api path /api/* /health/*
	handle @api {
		# Never cacheable by the browser or a service worker (P8-21); a response that sets its own value keeps it.
		header ?Cache-Control "no-store"
		reverse_proxy xd-api:8080 {
			health_uri /health/live
			health_interval 15s
		}
	}

	# SignalR hub (/hubs/events, ADR 0024 §7) → xd-api. Caddy's reverse_proxy upgrades WebSocket connections by itself (no
	# directive needed); the connection is long-lived, so it is flushed at once and a config reload does not cut it for 5 minutes.
	# The Host and Origin headers reach xd-api unchanged: it refuses any other origin (HubOriginMiddleware). The owner's session
	# cookie is checked by xd-api; the hub is not reachable without it. scripts/check-proxy.sh keeps this block in place.
	@hubs path /hubs/*
	handle @hubs {
		reverse_proxy xd-api:8080 {
			health_uri /health/live
			health_interval 15s
			flush_interval -1
			stream_close_delay 5m
		}
	}

	# Project documentation, served read-only from the repo: the clickable prototype (with the delivery plan at
	# /prototype/delivery/) and the generated design-docs site. Always revalidated so edits show immediately.
	# Not public: the proxy first asks the API whether the request carries a valid session cookie
	# (GET /api/auth/verify → 204); anything else is sent to the login page and returns here afterwards.
	redir /prototype /prototype/ permanent
	redir /docs /docs/ permanent
	handle_path /prototype/* {
		forward_auth xd-api:8080 {
			uri /api/auth/verify
			@unauthenticated status 401
			handle_response @unauthenticated {
				redir * /login?next={http.request.orig_uri.path} 302
			}
		}
		root * /srv-static/prototype
		header Cache-Control "no-cache"
		# The prototype and the docs site use inline scripts and styles of their own (static, read-only content).
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		file_server
	}
	handle_path /docs/* {
		forward_auth xd-api:8080 {
			uri /api/auth/verify
			@unauthenticated status 401
			handle_response @unauthenticated {
				redir * /login?next={http.request.orig_uri.path} 302
			}
		}
		root * /srv-static/docs
		header Cache-Control "no-cache"
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		file_server
	}

	# Defence in depth: the docs are mounted outside the SPA root (/srv), and any path that still looks like them but was not
	# caught by the guarded handlers above (odd casing, repeated slashes, encoded segments) is refused, never served.
	@unguardedDocs path_regexp (?i)^/+(prototype|docs)(/|$)
	handle @unguardedDocs {
		respond "Not found" 404
	}

	root * /srv

	# Content-hashed build assets that exist: cached for a year.
	@hashed {
		path /assets/*
		file
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# A missing asset is a real 404 (no SPA fallback).
	handle /assets/* {
		file_server
	}

	# The web app manifest: Caddy has no built-in type for .webmanifest. The worker (/sw.js) and /offline.html fall under the
	# fallback below (never cached by the proxy's headers; scope / and the CSP's script-src 'self' already cover the worker).
	header /manifest.webmanifest Content-Type "application/manifest+json"

	# Everything else is the single-page app: index.html for client-side routes, never cached.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
