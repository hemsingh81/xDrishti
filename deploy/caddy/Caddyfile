# xd-proxy: the only published entry point. Serves the React build and routes API traffic to xd-api.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# API, OpenAPI docs and health → xd-api (later also /hubs for SignalR and /hangfire).
	@api path /api/* /health/*
	handle @api {
		reverse_proxy xd-api:8080 {
			health_uri /health/live
			health_interval 15s
		}
	}

	# Project documentation, served read-only from the repo: the clickable prototype (with the delivery plan at
	# /prototype/delivery/) and the generated design-docs site. Always revalidated so edits show immediately.
	redir /prototype /prototype/ permanent
	redir /docs /docs/ permanent
	handle_path /prototype/* {
		root * /srv/prototype
		header Cache-Control "no-cache"
		file_server
	}
	handle_path /docs/* {
		root * /srv/docs
		header Cache-Control "no-cache"
		file_server
	}

	root * /srv

	# Content-hashed build assets that exist: cached for a year.
	@hashed {
		path /assets/*
		file
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# A missing asset is a real 404 (no SPA fallback).
	handle /assets/* {
		file_server
	}

	# Everything else is the single-page app: index.html for client-side routes, never cached.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
