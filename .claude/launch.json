{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "url": "http://localhost:8080"
    },
    {
      "name": "web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "docs-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8765", "--directory", "docs/site"],
      "port": 8765
    },
    {
      "name": "prototype",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8766", "--directory", "docs/prototype"],
      "port": 8766
    }
  ]
}
